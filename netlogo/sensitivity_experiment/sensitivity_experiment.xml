    <enumeratedValueSet variable="el-farol-threshold"><value value="0.6"/></enumeratedValueSet>
    <enumeratedValueSet variable="control-seed?"><value value="true"/></enumeratedValueSet>
    <enumeratedValueSet variable="current-seed">
      <value value="11"/>
      <value value="101"/>
      <value value="202"/>
      <value value="303"/>
      <value value="404"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="n-sim-days"><value value="14"/></enumeratedValueSet>
