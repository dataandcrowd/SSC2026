  <!-- LoS capacity assumption: vary the design-hour K-factor.
       k-factor is measurement-only (hourly capacity = ADT x K), so traffic
       dynamics are identical across values; this tests how robust the
       group-level LoS E/F conclusions are to the capacity assumption. -->
  <experiment name="sensitivity-kfactor" repetitions="1" runMetricsEveryStep="true">
    <setup>setup</setup>
    <go>go-days</go>
    <exitCondition>current-sim-day &gt;= n-sim-days</exitCondition>
    <metric>peak-vc-inner</metric>
    <metric>current-sim-day</metric>
