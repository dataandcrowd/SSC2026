  <!-- El Farol multi-seed replication.
       Purpose: the calibrated model shows El Farol's ToU effect collapsing to
       ~0 and the sf300 alternate-day oscillation disappearing. Both findings
       rest on a single seed, so this varies the seed at the baseline
       threshold (0.6) to check they are demand-driven, not seed-specific.

       IMPORTANT: `setup` runs `random-seed current-seed` whenever
       control-seed? is on (it is, seed 11), so raising `repetitions` does NOT
       vary the seed - every repetition is bit-identical (verified headless).
       Seeds must be varied through this enumeratedValueSet. Seed 11 is kept
       first so one cell reproduces the existing sensitivity-elfarol result. -->
  <experiment name="elfarol-seeds" repetitions="1" runMetricsEveryStep="true">
    <setup>setup</setup>
    <go>go-days</go>
    <exitCondition>current-sim-day &gt;= n-sim-days</exitCondition>
    <metric>peak-vc-inner</metric>
    <metric>current-sim-day</metric>
    <metric>peak-vc-boundary</metric>
    <metric>peak-vc-peripheral</metric>
    <metric>peak-ef-mwy</metric>
    <metric>peak-ef-cbd</metric>
    <metric>peak-ef-east</metric>
    <metric>peak-ef-west</metric>
    <metric>pct-los-ef-am-g "MWY"</metric>
    <metric>pct-los-ef-am-g "CBD"</metric>
    <metric>pct-los-ef-am-g "East"</metric>
    <metric>pct-los-ef-am-g "West"</metric>
    <enumeratedValueSet variable="decision-rule"><value value="&quot;El Farol&quot;"/></enumeratedValueSet>
    <enumeratedValueSet variable="fee-regime"><value value="&quot;No-Charge&quot;"/><value value="&quot;tou&quot;"/></enumeratedValueSet>
    <enumeratedValueSet variable="el-farol-threshold"><value value="0.6"/></enumeratedValueSet>
    <enumeratedValueSet variable="control-seed?"><value value="true"/></enumeratedValueSet>
    <enumeratedValueSet variable="current-seed">
      <value value="11"/>
      <value value="101"/>
      <value value="202"/>
      <value value="303"/>
      <value value="404"/>
    </enumeratedValueSet>
    <enumeratedValueSet variable="n-sim-days"><value value="5"/></enumeratedValueSet>
  </experiment>

