<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[;; Cordon-Lite NetLogo model. One file, two uses:
;;  - Open it to watch a run: every car drives on the TomTom major-road network of Auckland from its
;;    origin to its gate, waits in the gate queue and parks at its workplace in the city centre. The
;;    model plays each morning until every commuter has arrived (1 tick = 15 simulated seconds).
;;  - Python drives it headless as NetLogoEngine (cordonlite/engine.py) through setup-from-dir,
;;    set-clock and run-day, exchanging CSV files with a run folder; that path loads no map.
;; Both uses compute the day with the same two procedures, identical to PyEngine: road-arrivals (the
;; congested roads from home to the gate, cordonlite/roads.py simulate_roads) and point-queues (one
;; Vickrey point queue per corridor at minute resolution).
;;
;; Each commuter lives at its Cordon-Lite origin and works in one building inside the cordon, drawn
;; at random once (fixed seed) and kept for every day. On each day (plans_dayNN.csv of a run folder)
;; a car leaves home at its departure minute, drives the free-flow shortest path to its gate (the
;; prep gate of its origin: where its path first enters the cordon), waits in its corridor's queue
;; and drives on to its building. The minutes are the engine's: gate arrival = departure + free-flow
;; minutes to the gate (agents.csv) + road delay (road-arrivals: traffic on the way, 0 without the
;; road files); gate exit from point-queues (the same FIFO order, carry and cap as PyEngine, so the
;; same minutes); arrival = gate exit + free-flow minutes from the gate. The network only says where
;; a car is between those minutes (before the gate it follows its section times from road-arrivals,
;; plan-drives). PT riders leave home and appear at their building at the PT arrival minute of the
;; run (outcomes.csv); WFH and SKIP stay at home. The roads on the commuters' routes are coloured by
;; how fast their traffic moves, every 5 minutes (update-road-colours). Nothing here feeds back into
;; a Cordon-Lite run.
;;
;; Inputs, relative to this model:
;;   scenario-dir     a run folder of python -m cordonlite.run (corridors.csv, agents.csv, fees.csv,
;;                    plans_dayNN.csv, scenario.csv, personas.csv, outcomes.csv; road_sections.csv,
;;                    agent_routes.csv, road_profile.csv, road_params.csv when roads are congested)
;;                    or demo_scenario (free-flow roads)
;;   gis/tomtom_major_roads.shp, gis/cordon.shp, gis/cbd_buildings.shp, gis/cbd_buildings.csv
;;                                                     map layers (prep.build_netlogo_layers)
;;   ../data/origins.csv, ../data/gates.csv            prep outputs: the gate of every origin
;;   ../data/section_segments.csv                      prep.build_roads: the TomTom segments of each
;;                                                     road section (road colours)

extensions [ csv table gis nw ]

globals [
  ;; scenario (a run folder of python -m cordonlite.run)
  scen-dir            ;; folder loaded by setup
  sim-start-min       ;; first minute simulated
  sim-end-cap-min     ;; last minute a queue is served
  corr-ids            ;; corridor ids, ascending
  corr-caps           ;; capacity (cars per minute), same order
  corr-names          ;; corridor names, same order
  corr-xy             ;; [x y] NZTM of each corridor, same order
  corr-index          ;; table corridor_id -> position in the lists above
  agent-fg            ;; table agent_id -> free-flow minutes origin to gate
  agent-gd            ;; table agent_id -> free-flow minutes gate to destination
  commuter-of         ;; table agent_id -> commuter
  agent-corr          ;; table agent_id -> corridor_id
  fee-list            ;; 1440 fees by minute (fees.csv)
  charge-from-day     ;; from scenario.csv: first charged day (0 = never); -1 = use the fee-start-day input
  scen-n-days         ;; from scenario.csv: number of days in the run; -1 = unknown (demo)
  pt-times            ;; table "day agent_id" -> [depart arrive] of PT trips (outcomes.csv of a run)
  ;; the day on screen
  current-day         ;; 0 before the first day
  day-running?        ;; a day is being animated
  clock               ;; minutes after midnight
  day-start           ;; first minute shown today
  day-end-min         ;; the day ends at this minute (the last arrival)
  vehicles-per-agent  ;; real cars one agent stands for (agents_represented / agents)
  fee-active-today?   ;; charge levied today
  n-cars              ;; cars today
  mean-delay          ;; mean queue delay (min) of today's served cars
  max-delay           ;; max queue delay (min) today
  day-exits           ;; gate-exit minutes of today's served cars (cordon entries)
  last-plot-min       ;; last minute plotted today
  ;; headless engine (run-day, NetLogoEngine): the last day computed
  agent-mode          ;; table agent_id -> mode
  last-minute         ;; last minute processed
  last-profile        ;; rows [day corridor_id minute arrivals served queue_len]
  last-exits          ;; gate-exit minutes of the served cars
  last-road           ;; rows [day section_id minute entries] (road_dayNN.csv)
  ;; roads from home to the gate (read-roads; PyEngine: cordonlite/roads.py)
  road-on?            ;; the road files were read; false = free-flow roads (road delay 0)
  sec-ids             ;; road section ids, ascending
  sec-index           ;; table section_id -> position in the section lists below
  sec-ff              ;; free-flow minutes of each section
  sec-cap             ;; capacity (veh/h, one direction)
  sec-bg              ;; background peak-hour flow (veh/h)
  sec-obs             ;; observed peak-hour flow (veh/h: background + usual commuters)
  sec-w               ;; commuter weight (w_factor)
  sec-fpe             ;; veh/h that one commuter entry adds while it is in the flow window
  agent-route         ;; table agent_id -> section positions of its route to the gate, from home
  road-r              ;; 1440 time-profile values by minute (share of the peak-hour flow)
  road-alpha          ;; BPR alpha (beta is 4)
  road-floor          ;; lowest speed factor
  road-window         ;; flow window (min): commuter entries counted at minutes m - window .. m - 1
  road-vpa            ;; real cars one agent stands for (road_params.csv vehicles_per_agent)
  today-road          ;; road-arrivals result of the day on screen ([] before the first day)
  ;; road colours (GUI): traffic speed on the sections of the commuters' routes
  sec-feats           ;; road features (TomTom segments) of each section, sec-ids order
  sec-feats-cc        ;; the same, only those near the cordon (City centre view)
  sec-frc             ;; TomTom frc of each section (0 = motorway)
  sec-order           ;; section positions in drawing order: local roads first, motorways last
  speed-grade         ;; grade of each section at grade-minute, from its speed (speed-grade-of):
                      ;; 0 = normal, 1 = slow, 2 = heavy, 3 = jammed
  grade-minute        ;; minute of those grades (a multiple of 5; -1 = grade again)
  grade-shown         ;; grade each section is drawn in on the map
  grade-pending       ;; sections whose colour on the map is not their grade's yet (redrawn by ticks)
  grade-entries       ;; today's commuter entries by minute: item (m - grade-first-min) = [[i n] ...],
                      ;; n entries of the section at position i at minute m
  grade-first-min     ;; minute of the first item of grade-entries
  ;; map and network
  map-view            ;; "Auckland" | "City centre"
  map-env             ;; [minx maxx miny maxy] NZTM of the world edges (gis:world-envelope)
  net-env             ;; map-env of the Auckland view, where the (hidden) nodes are placed
  roads-ds            ;; GIS datasets
  cordon-ds
  buildings-ds
  road-classes        ;; road features by TomTom frc 0..4 (drawing style)
  road-classes-cc     ;; the same, only features near the cordon (City centre view)
  main-inner          ;; the largest connected set of cordon nodes (roads with both ends inside)
  node-at             ;; table "X Y" (NZTM rounded to 1 m) -> node
  seg-ends            ;; table gate segment_id -> [node node]
  route-cache         ;; table "who who" -> list of nodes
]

;; breeds declared later are drawn on top
breed [ nodes node ]
undirected-link-breed [ roads road ]
breed [ buildings building ]
breed [ gates gate ]
breed [ commuters commuter ]
breed [ tags tag ]               ;; corridor labels, drawn above gates and cars
tags-own [ tag-cid ]             ;; the corridor a tag labels
nodes-own [ nx ny in-cordon? ]   ;; NZTM metres rounded to 1 m, as the prep graph
roads-own [
  tt                  ;; free-flow minutes = distance / speed limit (the prep weight)
  tt-in               ;; tt + cordon-exit-penalty on a road with an end outside the cordon
]
buildings-own [ building-id bx by bnode ]   ;; point inside the footprint; nearest node in the cordon
gates-own [ gate-id corridor-id gx gy u-node v-node ]   ;; gate point; outside and inside end node
commuters-own [
  agent-id corridor-id home-x home-y home-node my-gate work-building
  route-out len-out   ;; NZTM [x y] points home -> gate point, and cumulative metres
  tt-out              ;; free-flow minutes from home to each point of route-out (at the gate point:
                      ;; to the inside end of the gate segment, as the engine's route)
  route-in len-in     ;; NZTM [x y] points gate point -> building, and cumulative metres
  mode-today dep gate-arr gate-exit arr   ;; today's trip in minutes (-1 = none)
  road-delay          ;; today's road delay (whole minutes; -1 = not driving today)
  t-out               ;; minute at which today's car passes each point of route-out (plan-drives)
  out-ptr             ;; the route-out point the car passed last (place-now)
  q-rank              ;; place in the queue at its gate (0 = head)
]

;; ------------------------------------------------------------------ constants

to-report roads-file
  report path-join map-dir "tomtom_major_roads.shp"
end

to-report map-dir
  report "gis"
end

to-report prep-dir
  report "../data"
end

to-report workplace-seed
  report 2027
end

;; animation steps per simulated minute: 1 tick = 15 s, so cars move smoothly
to-report steps-per-minute
  report 4
end

;; Road length one queued agent takes up, metres. An agent stands for vehicles-per-agent cars (about
;; 63 in a 300-agent run); at 7 m per car in 2 lanes [A] that is about 220 m, so a queue drawn back
;; along the approach road is as long as the real queue it stands for.
to-report queue-spacing-m
  report max (list 15 (vehicles-per-agent * 7 / 2))
end

;; minutes added to a road with an end outside the cordon when routing a car from its gate to its
;; building, so that it leaves the cordon only where the roads inside do not connect
to-report cordon-exit-penalty
  report 60
end

;; free-flow minutes of a straight hop of m metres where a route has no road (a home off the road
;; network, a gate without its segment's inside end): 50 km/h
to-report hop-tt [ m ]
  report m / 1000 / 50 * 60
end

;; map style of TomTom frc k (0 motorway .. 4 local): grey shade, and line width in each view
to-report road-color [ k ]
  report item k [ 7 5 4 3 2.5 ]
end

to-report road-width [ k cc? ]
  report item k ifelse-value cc? [ [ 3 2.5 2 1.5 1 ] ] [ [ 1.5 1 0.8 0.5 0.5 ] ]
end

;; a road section on the commuters' routes is drawn a little wider than other roads of its class,
;; and wider again the slower its traffic (speed grade g), so that its colour shows in both views
to-report section-width [ k g cc? ]
  report (max (list (road-width k cc?) ifelse-value cc? [ 2.5 ] [ 1.2 ])) + g * ifelse-value cc? [ 0.6 ] [ 0.5 ]
end

;; colours (RGB) of slow, heavy and jammed traffic (normal traffic keeps the road's grey): light
;; yellow, amber orange, bright purple, all clearly visible on black. No red (queued cars), no green
;; (public transport), and none of the corridor colours of the cars (corridor-color: 105 blue, 45
;; yellow, 125 magenta, 25 orange, 85 cyan): the yellow is paler, the orange yellower and the purple
;; lighter than the nearest car colour, so a car stands out on any road
to-report grade-colors
  report [ [ 255 235 120 ] [ 255 160 0 ] [ 185 95 255 ] ]
end

;; speed grades by speed factor f (share of free-flow speed): normal f >= 0.80, slow 0.60 to 0.80,
;; heavy 0.40 to 0.60, jammed below 0.40 (these are the lower bounds of the first three)
to-report grade-bands
  report [ 0.80 0.60 0.40 ]
end

;; ------------------------------------------------------------------ helpers

to-report path-join [ dir file ]
  report (word dir "/" file)
end

to-report pad2 [ d ]
  report ifelse-value (d < 10) [ (word "0" d) ] [ (word d) ]
end

to-report col [ header name ]
  let i position name header
  if i = false [ error (word "column " name " missing") ]
  report i
end

to-report read-rows [ dir file ]
  let f path-join dir file
  if not file-exists? f [ error (word "missing file " f) ]
  report filter [ r -> length r > 1 ] csv:from-file f
end

;; no greens (PT) and no red (cars waiting in a gate queue) in the corridor palette
to-report corridor-color [ cid ]
  let palette [ 105 45 125 25 85 135 95 115 35 5 ]
  report item ((table:get corr-index cid) mod length palette) palette
end

;; "South-west (Fanshawe Street ramp, ...)" -> "SW"
to-report compass-abbrev [ nm ]
  let i position " (" nm
  let head ifelse-value (i = false) [ nm ] [ substring nm 0 i ]
  let k position head [ "North" "North-east" "East" "South-east" "South" "South-west" "West" "North-west" ]
  if k != false [ report item k [ "N" "NE" "E" "SE" "S" "SW" "W" "NW" ] ]
  let out ""
  let new-word? true
  foreach n-values length head [ j -> item j head ] [ ch ->
    if new-word? and (ch != "-") and (ch != " ") [ set out (word out ch) ]
    set new-word? (ch = "-") or (ch = " ")
  ]
  report out
end

to-report charge-on? [ d ]
  if charge-from-day >= 0 [ report (charge-from-day > 0) and (d >= charge-from-day) ]
  report d >= fee-start-day
end

to-report hhmm [ m ]
  let mm floor m
  report (word pad2 floor (mm / 60) ":" pad2 (mm mod 60))
end

to-report xy-key [ x y ]
  report (word round x " " round y)
end

to-report dist-m [ a b ]
  report sqrt (((item 0 b) - (item 0 a)) ^ 2 + ((item 1 b) - (item 1 a)) ^ 2)
end

;; ------------------------------------------------------------------ setup

to setup
  clear-all
  set scen-dir scenario-dir
  set sim-start-min 330
  set sim-end-cap-min 720
  set current-day 0
  set day-running? false
  set clock sim-start-min
  set day-start sim-start-min
  set day-end-min sim-start-min
  set fee-active-today? false
  set n-cars 0
  set mean-delay 0
  set max-delay 0
  set day-exits []
  set last-plot-min -1
  set route-cache table:make
  set today-road []
  read-corridors
  read-agents
  read-fees
  read-scenario-meta
  read-clock
  read-roads
  read-pt-times
  print (word "Cordon-Lite network model: " count commuters " commuters, " length corr-ids " corridors from " scen-dir)
  load-map
  build-network
  read-section-map
  read-buildings
  make-gates
  assign-workplaces
  make-routes
  set-map-view "Auckland"
  reset-ticks
  print "Ready: press go to drive the next day."
end

to read-scenario-meta
  set charge-from-day -1
  set scen-n-days -1
  let f path-join scen-dir "scenario.csv"
  if file-exists? f [
    foreach but-first csv:from-file f [ r ->
      if (item 0 r) = "charge_from_day" [ set charge-from-day item 1 r ]
      if (item 0 r) = "n_days" [ set scen-n-days item 1 r ]
    ]
  ]
end

;; From the run's config_snapshot.toml: the engine clock ([time] sim_start_min, sim_end_cap_min; the
;; values NetLogoEngine passes with set-clock) and [engine] agents_represented. Without the file
;; (demo_scenario) the config.toml values: 330, 720 and 19,000. With road files read-roads then sets
;; vehicles-per-agent to their value.
to read-clock
  let represented 19000
  let f path-join scen-dir "config_snapshot.toml"
  if file-exists? f [
    let section ""
    file-open f
    while [ not file-at-end? ] [
      let txt file-read-line
      if (length txt > 0) and (first txt = "[") [ set section txt ]
      if member? "=" txt [
        let k position "=" txt
        let key-name remove " " substring txt 0 k
        let value-text substring txt (k + 1) (length txt)
        if section = "[time]" and key-name = "sim_start_min" [ set sim-start-min read-from-string value-text ]
        if section = "[time]" and key-name = "sim_end_cap_min" [ set sim-end-cap-min read-from-string value-text ]
        if section = "[engine]" and key-name = "agents_represented" [ set represented read-from-string value-text ]
      ]
    ]
    file-close
  ]
  set vehicles-per-agent represented / max (list 1 count commuters)
  set clock sim-start-min
  set day-start sim-start-min
  set day-end-min sim-start-min
end

to read-corridors
  let rows read-rows scen-dir "corridors.csv"
  let h first rows
  let ic col h "corridor_id"
  let ik col h "capacity_per_min"
  let iname col h "name"
  let ix col h "x"
  let iy col h "y"
  let body sort-by [ [a b] -> (item ic a) < (item ic b) ] but-first rows
  set corr-ids map [ r -> item ic r ] body
  set corr-caps map [ r -> item ik r ] body
  set corr-names map [ r -> (word item iname r) ] body
  set corr-xy map [ r -> list (item ix r) (item iy r) ] body
  set corr-index table:make
  foreach range length corr-ids [ k -> table:put corr-index (item k corr-ids) k ]
end

to read-agents
  let rows read-rows scen-dir "agents.csv"
  let h first rows
  let ia col h "agent_id"
  let ic col h "corridor_id"
  let ig col h "fftt_to_gate_min"
  let id col h "fftt_gate_to_dest_min"
  let ix col h "x"
  let iy col h "y"
  set agent-fg table:make
  set agent-gd table:make
  set agent-corr table:make
  set commuter-of table:make
  foreach but-first rows [ r ->
    let aid item ia r
    table:put agent-corr aid (item ic r)
    table:put agent-fg aid (item ig r)
    table:put agent-gd aid (item id r)
    create-commuters 1 [
      set agent-id aid
      set corridor-id item ic r
      set home-x item ix r
      set home-y item iy r
      set mode-today "NONE"
      set dep -1
      set gate-arr -1
      set gate-exit -1
      set arr -1
      set q-rank 0
      set hidden? true
      table:put commuter-of aid self
    ]
  ]
end

to read-fees
  let rows read-rows scen-dir "fees.csv"
  let h first rows
  let im col h "minute"
  let ifee col h "fee"
  let t table:make
  foreach but-first rows [ r -> table:put t (item im r) (item ifee r) ]
  set fee-list n-values 1440 [ m -> ifelse-value (table:has-key? t m) [ table:get t m ] [ 0 ] ]
end

;; The road files of a run folder (cordonlite/roads.py write_road_scenario), all four or none:
;;   road_sections.csv  section_id, ff_min, cap_vph, bg_peak_vph, obs_peak_vph, w_factor
;;   agent_routes.csv   agent_id, seq, section_id (the route from home to the gate, seq 0 at home)
;;   road_profile.csv   minute, r (1440 rows)
;;   road_params.csv    key, value: bpr_alpha, bpr_beta (4), speed_floor, flow_window_min,
;;                      vehicles_per_agent
;; Without them road-on? is false and every car drives at free flow. With them vehicles-per-agent is
;; the file's value (not agents_represented / commuters), as in PyEngine. Python checks the files
;; (cordonlite.roads.read_road_scenario) before NetLogoEngine loads them.
to read-roads
  set road-on? false
  set sec-ids []
  set sec-index table:make
  set sec-ff []
  set sec-cap []
  set sec-bg []
  set sec-obs []
  set sec-w []
  set sec-fpe []
  set agent-route table:make
  set road-r []
  let files [ "road_sections.csv" "agent_routes.csv" "road_profile.csv" "road_params.csv" ]
  let present filter [ fname -> file-exists? path-join scen-dir fname ] files
  if empty? present [ stop ]
  if length present < length files [ error (word "incomplete road files in " scen-dir ": only " present) ]
  ;; parameters
  let p table:make
  foreach but-first read-rows scen-dir "road_params.csv" [ r -> table:put p (word item 0 r) (item 1 r) ]
  foreach [ "bpr_alpha" "bpr_beta" "speed_floor" "flow_window_min" "vehicles_per_agent" ] [ key ->
    if not table:has-key? p key [ error (word "road_params.csv lacks " key) ]
  ]
  if (table:get p "bpr_beta") != 4 [ error "road_params.csv: bpr_beta must be 4 (the engines compute (x * x) * (x * x))" ]
  set road-alpha table:get p "bpr_alpha"
  set road-floor table:get p "speed_floor"
  set road-window table:get p "flow_window_min"
  set road-vpa table:get p "vehicles_per_agent"
  ;; sections, ascending section_id
  let rows read-rows scen-dir "road_sections.csv"
  let h first rows
  let isec col h "section_id"
  let iff col h "ff_min"
  let icap col h "cap_vph"
  let ibg col h "bg_peak_vph"
  let iobs col h "obs_peak_vph"
  let iw col h "w_factor"
  let body sort-by [ [a b] -> (item isec a) < (item isec b) ] but-first rows
  set sec-ids map [ r -> item isec r ] body
  set sec-ff map [ r -> item iff r ] body
  set sec-cap map [ r -> item icap r ] body
  set sec-bg map [ r -> item ibg r ] body
  set sec-obs map [ r -> item iobs r ] body
  set sec-w map [ r -> item iw r ] body
  foreach range length sec-ids [ k -> table:put sec-index (item k sec-ids) k ]
  ;; the same expression as RoadScenario.fpe: ((vehicles_per_agent * w_factor) * 60) / window
  set sec-fpe map [ w -> ((road-vpa * w) * 60) / road-window ] sec-w
  ;; time profile
  set rows read-rows scen-dir "road_profile.csv"
  set h first rows
  let im col h "minute"
  let ir col h "r"
  let t table:make
  foreach but-first rows [ r -> table:put t (item im r) (item ir r) ]
  foreach range 1440 [ m -> if not table:has-key? t m [ error (word "road_profile.csv lacks minute " m) ] ]
  set road-r n-values 1440 [ m -> table:get t m ]
  ;; routes: section positions in seq order
  set rows read-rows scen-dir "agent_routes.csv"
  set h first rows
  let ia col h "agent_id"
  let iq col h "seq"
  set isec col h "section_id"
  let legs table:make   ;; agent_id -> [seq section_id] rows
  foreach but-first rows [ r ->
    table:put legs (item ia r) (lput (list (item iq r) (item isec r)) (table:get-or-default legs (item ia r) []))
  ]
  foreach sort table:keys legs [ aid ->
    let ordered sort-by [ [a b] -> (item 0 a) < (item 0 b) ] table:get legs aid
    table:put agent-route aid map [ q -> table:get sec-index (item 1 q) ] ordered
  ]
  set road-on? true
  set vehicles-per-agent road-vpa
end

;; PT departure and arrival minutes of every PT trip of the run (outcomes.csv); empty without it
to read-pt-times
  set pt-times table:make
  let f path-join scen-dir "outcomes.csv"
  if not file-exists? f [ stop ]
  let rows read-rows scen-dir "outcomes.csv"
  let h first rows
  let ia col h "agent_id"
  let id col h "day"
  let im col h "mode"
  let idep col h "depart_min"
  let iarr col h "arrive_min"
  foreach but-first rows [ r ->
    if (item im r) = "PT" and is-number? item idep r and is-number? item iarr r [
      table:put pt-times (word item id r " " item ia r) (list (item idep r) (item iarr r))
    ]
  ]
end

;; ------------------------------------------------------------------ map and network

to load-map
  foreach (list roads-file (path-join map-dir "cordon.shp") (path-join map-dir "cbd_buildings.shp")
                (path-join map-dir "cbd_buildings.csv")) [ f ->
    if not file-exists? f [ error (word "missing " f ": run python -m prep.build_netlogo_layers") ]
  ]
  ;; every layer is NZTM2000 (EPSG:2193) and is used in its own coordinates, so no coordinate
  ;; system is loaded (gis:load-coordinate-system on each setup only printed a re-projection warning)
  set roads-ds gis:load-dataset roads-file
  set cordon-ds gis:load-dataset path-join map-dir "cordon.shp"
  set buildings-ds gis:load-dataset path-join map-dir "cbd_buildings.shp"
  set road-classes map [ k -> filter [ f -> gis:property-value f "frc" = k ] gis:feature-list-of roads-ds ]
                       [ 0 1 2 3 4 ]
  ;; the City centre view draws only the roads near the cordon
  let near near-cordon-envelope
  set road-classes-cc map [ fs -> filter [ f -> envelopes-overlap? gis:envelope-of f near ] fs ] road-classes
  ;; the network is built (and nodes placed) in the Auckland view
  apply-envelope view-envelope "Auckland"
  set map-view "Auckland"
  set net-env map-env
end

;; Nodes and roads from the TomTom shapefile, as the prep graph (prep/build_inputs.py, build_graph):
;; a node per segment end, NZTM rounded to 1 m; segments whose ends coincide are dropped; of
;; parallel segments between the same two nodes the fastest is kept (28,520 nodes, 30,846 roads);
;; then only the giant component is kept: 28,507 nodes and 30,835 roads, the graph prep routes on.
to build-network
  reset-timer
  set node-at table:make
  set seg-ends table:make
  let gate-segs table:make
  let grows read-rows prep-dir "gates.csv"
  let iseg col first grows "segment_id"
  foreach but-first grows [ r -> table:put gate-segs (word item iseg r) true ]
  let best table:make   ;; "who who" -> [a b minutes]
  foreach gis:feature-list-of roads-ds [ f ->
    let vl first gis:vertex-lists-of f
    let a node-for nztm-of gis:location-of first vl
    let b node-for nztm-of gis:location-of last vl
    let sid (word gis:property-value f "segment_id")
    if table:has-key? gate-segs sid [ table:put seg-ends sid (list a b) ]
    if a != b [
      let t (gis:property-value f "distance") / 1000 / (gis:property-value f "speedLimit") * 60
      let key ifelse-value ([who] of a < [who] of b) [ (word [who] of a " " [who] of b) ] [ (word [who] of b " " [who] of a) ]
      if (not table:has-key? best key) or (t < item 2 table:get best key) [ table:put best key (list a b t) ]
    ]
  ]
  foreach table:values best [ ent ->
    ask item 0 ent [ create-road-with item 1 ent [ set tt item 2 ent  set hidden? true ] ]
  ]
  nw:set-context nodes roads
  ;; the two small fragments (13 nodes, none in the cordon) cannot be reached from anywhere else
  let comps sort-by [ [p q] -> count p > count q ] nw:weak-component-clusters
  foreach but-first comps [ c -> ask c [ table:remove node-at xy-key nx ny  die ] ]
  ;; inside the cordon (on its boundary counts as inside, as prep's inside_mask)
  let ce gis:envelope-of cordon-ds
  ask nodes [ set in-cordon? false ]
  ask nodes with [ nx >= item 0 ce and nx <= item 1 ce and ny >= item 2 ce and ny <= item 3 ce ]
    [ set in-cordon? gis:intersects? cordon-ds self ]
  ask roads [ set tt-in tt + ifelse-value ([in-cordon?] of end1 and [in-cordon?] of end2) [ 0 ] [ cordon-exit-penalty ] ]
  ;; the cordon's own roads fall into 15 pieces (the SA3 line cuts some streets); buildings are
  ;; reached from the largest, which holds 1,066 of the 1,106 cordon nodes
  nw:with-context (nodes with [ in-cordon? ]) (roads with [ [in-cordon?] of end1 and [in-cordon?] of end2 ]) [
    set main-inner first sort-by [ [p q] -> count p > count q ] nw:weak-component-clusters
  ]
  print (word "Road network: " count nodes " nodes, " count roads " roads, "
              count nodes with [ in-cordon? ] " nodes in the cordon (" precision timer 1 " s)")
end

;; [minx maxx miny maxy] NZTM: a square around the City centre view envelope (the roads drawn there)
to-report near-cordon-envelope
  let ve view-envelope "City centre"
  let half 0.5 * max (list ((item 1 ve) - (item 0 ve)) ((item 3 ve) - (item 2 ve)))
  let cx ((item 0 ve) + (item 1 ve)) / 2
  let cy ((item 2 ve) + (item 3 ve)) / 2
  report (list (cx - half) (cx + half) (cy - half) (cy + half))
end

;; The road features of every section of this run (road_sections.csv), from the prep file
;; ../data/section_segments.csv (section_id, seq, segment_id: the TomTom segments of each section),
;; and each section's frc. Sections are then graded at the clock (before the first day: background
;; traffic only). Without road files, or without that file, roads keep their grey.
to read-section-map
  set sec-feats []
  set sec-feats-cc []
  set sec-frc []
  set sec-order []
  set speed-grade []
  set grade-shown []
  set grade-pending []
  set grade-minute -1
  set grade-entries []
  set grade-first-min 0
  if not road-on? [ stop ]
  if not file-exists? path-join prep-dir "section_segments.csv" [
    print (word "No " path-join prep-dir "section_segments.csv" ": roads are not coloured by traffic")
    stop
  ]
  let rows read-rows prep-dir "section_segments.csv"
  let isec col first rows "section_id"
  let iseg col first rows "segment_id"
  let pos-of table:make        ;; segment_id -> section position
  foreach but-first rows [ r ->
    if table:has-key? sec-index item isec r [ table:put pos-of (word item iseg r) (table:get sec-index item isec r) ]
  ]
  let found table:make         ;; section position -> its features
  foreach gis:feature-list-of roads-ds [ ft ->
    let sid (word gis:property-value ft "segment_id")
    if table:has-key? pos-of sid [
      let i table:get pos-of sid
      table:put found i (lput ft (table:get-or-default found i []))
    ]
  ]
  set sec-feats map [ i -> table:get-or-default found i [] ] range length sec-ids
  set sec-frc map [ fs -> ifelse-value (empty? fs) [ 4 ] [ gis:property-value first fs "frc" ] ] sec-feats
  let near near-cordon-envelope
  set sec-feats-cc map [ fs -> filter [ ft -> envelopes-overlap? gis:envelope-of ft near ] fs ] sec-feats
  set sec-order sort-by [ [a b] -> ((item a sec-frc) > (item b sec-frc)) or (((item a sec-frc) = (item b sec-frc)) and (a < b)) ]
                        range length sec-ids
  let n-missing length filter empty? sec-feats
  if n-missing > 0 [ print (word n-missing " road sections have no segment in section_segments.csv and are not coloured") ]
  set grade-shown n-values length sec-ids [ 0 ]
  regrade-roads
end

;; NetLogo [x y] -> NZTM [X Y]: inverse of the linear map of the current world envelope
to-report envelopes-overlap? [ a b ]
  report ((item 0 a) <= (item 1 b)) and ((item 1 a) >= (item 0 b)) and
         ((item 2 a) <= (item 3 b)) and ((item 3 a) >= (item 2 b))
end

to-report nztm-of [ p ]
  report (list ((item 0 map-env) + ((item 0 p) - (min-pxcor - 0.5)) * ((item 1 map-env) - (item 0 map-env)) / world-width)
               ((item 2 map-env) + ((item 1 p) - (min-pycor - 0.5)) * ((item 3 map-env) - (item 2 map-env)) / world-height))
end

to-report node-for [ xy ]
  let key xy-key (item 0 xy) (item 1 xy)
  if table:has-key? node-at key [ report table:get node-at key ]
  let n nobody
  create-nodes 1 [
    set nx round item 0 xy
    set ny round item 1 xy
    set hidden? true
    let p map-xy nx ny
    setxy (item 0 p) (item 1 p)
    set n self
  ]
  table:put node-at key n
  report n
end

to-report nearest-node [ x y candidates ]
  report min-one-of candidates [ (nx - x) ^ 2 + (ny - y) ^ 2 ]
end

;; workplaces: one point inside each footprint, gis/cbd_buildings.csv
to read-buildings
  let rows read-rows map-dir "cbd_buildings.csv"
  let h first rows
  let ii col h "building_id"
  let ix col h "x_nztm"
  let iy col h "y_nztm"
  foreach but-first rows [ r ->
    create-buildings 1 [
      set building-id item ii r
      set bx item ix r
      set by item iy r
      set bnode nobody
      set shape "square"
      set hidden? true
    ]
  ]
end

;; One gate turtle per prep gate an agent uses (data/origins.csv gate_id of its origin, found through
;; personas.csv origin_id or the origin coordinates). A scenario whose agents are not prep origins
;; (demo_scenario) queues each corridor at its corridor point instead.
to make-gates
  let origin-gate table:make     ;; origin_id -> gate_id
  let xy-gate table:make         ;; "X Y" -> gate_id
  let orows read-rows prep-dir "origins.csv"
  let oh first orows
  foreach but-first orows [ r ->
    table:put origin-gate (item (col oh "origin_id") r) (item (col oh "gate_id") r)
    table:put xy-gate (xy-key (item (col oh "x_nztm") r) (item (col oh "y_nztm") r)) (item (col oh "gate_id") r)
  ]
  let persona-origin table:make  ;; agent_id -> origin_id
  if file-exists? path-join scen-dir "personas.csv" [
    let prows read-rows scen-dir "personas.csv"
    let ph first prows
    if member? "origin_id" ph [
      foreach but-first prows [ r -> table:put persona-origin (item (col ph "agent_id") r) (item (col ph "origin_id") r) ]
    ]
  ]
  let grows read-rows prep-dir "gates.csv"
  let gh first grows
  let gate-row table:make
  foreach but-first grows [ r -> table:put gate-row (item (col gh "gate_id") r) r ]
  let gate-key table:make        ;; agent_id -> [gate_id corridor_id], gate_id -1 = corridor point
  ask commuters [
    set home-node ifelse-value table:has-key? node-at xy-key home-x home-y
      [ table:get node-at xy-key home-x home-y ] [ nearest-node home-x home-y nodes ]
    let gid -1
    if table:has-key? persona-origin agent-id [
      let oid table:get persona-origin agent-id
      if table:has-key? origin-gate oid [ set gid table:get origin-gate oid ]
    ]
    if gid = -1 and table:has-key? xy-gate xy-key home-x home-y [ set gid table:get xy-gate xy-key home-x home-y ]
    table:put gate-key agent-id (list gid corridor-id)
  ]
  let gate-of table:make         ;; "gate_id corridor_id" -> gate turtle
  foreach sort-on [ agent-id ] commuters [ c ->
    let gk table:get gate-key [ agent-id ] of c
    let key (word item 0 gk " " item 1 gk)
    if not table:has-key? gate-of key [ table:put gate-of key new-gate (item 0 gk) (item 1 gk) gate-row gh ]
    ask c [ set my-gate table:get gate-of key ]
  ]
end

;; a gate turtle: prep gate gid (its crossing point and the two ends of its segment), or the
;; corridor point of cid when gid = -1
to-report new-gate [ gid cid gate-row gh ]
  let g nobody
  create-gates 1 [
    set g self
    set gate-id gid
    set corridor-id cid
    set shape "target"
    set color corridor-color cid
    ifelse (gid >= 0) and table:has-key? gate-row gid [
      let r table:get gate-row gid
      set gx item (col gh "x_nztm") r
      set gy item (col gh "y_nztm") r
      let ends table:get-or-default seg-ends (word item (col gh "segment_id") r) []
      ifelse length ends = 2 [
        ;; prep gate: the path enters the cordon from the outside end u to the inside end v
        let outside filter [ n -> not [in-cordon?] of n ] ends
        set u-node ifelse-value (length outside = 1) [ first outside ] [ item 0 ends ]
        set v-node ifelse-value (u-node = item 0 ends) [ item 1 ends ] [ item 0 ends ]
      ] [
        set u-node nearest-node gx gy nodes with [ not in-cordon? ]
        set v-node nobody
      ]
    ] [
      let p item (table:get corr-index cid) corr-xy
      set gx item 0 p
      set gy item 1 p
      set u-node nearest-node gx gy nodes
      set v-node nobody
    ]
  ]
  report g
end

to assign-workplaces
  if not any? buildings [ error "no buildings in gis/cbd_buildings.csv" ]
  with-local-randomness [
    random-seed workplace-seed
    foreach sort-on [ agent-id ] commuters [ c -> ask c [ set work-building one-of buildings ] ]
  ]
  let inside ifelse-value any? main-inner [ main-inner ] [ nodes ]
  ask (turtle-set [ work-building ] of commuters) [ set bnode nearest-node bx by inside ]
end

;; shortest path a -> b on link weight w ("tt" or "tt-in") as a list of nodes (cached); a straight
;; hop when unreachable, which cannot happen on the giant component but is reported if it does
to-report route-nodes [ a b w ]
  if a = b [ report (list a) ]
  let key (word [who] of a " " [who] of b " " w)
  if table:has-key? route-cache key [ report table:get route-cache key ]
  let p false
  ;; the nw primitives take the weight as a literal name, not as a variable holding it
  ifelse w = "tt-in"
    [ ask a [ set p nw:turtles-on-weighted-path-to b "tt-in" ] ]
    [ ask a [ set p nw:turtles-on-weighted-path-to b "tt" ] ]
  if not is-list? p [
    print (word "No road path between " a " and " b ": drawn as a straight line")
    set p (list a b)
  ]
  table:put route-cache key p
  report p
end

to-report node-points [ ns ]
  report map [ n -> list ([nx] of n) ([ny] of n) ] ns
end

to-report cum-lengths [ pts ]
  let out [ 0 ]
  foreach range (length pts - 1) [ i -> set out lput ((last out) + dist-m (item i pts) (item (i + 1) pts)) out ]
  report out
end

;; home -> outside end of the gate segment -> gate point; gate point -> inside end -> building.
;; The leg from the gate is routed on tt-in, so a car that has passed its gate stays inside the
;; cordon wherever the cordon's roads connect (on plain tt about two thirds of these legs would
;; leave and re-enter it). On roads it leaves only from gates whose inside end connects to the rest
;; of the cordon through a road just outside it (the Wellesley Street ramp, about 100 to 160 m, and
;; Hopetoun Street); the setup message counts those legs. The car parks at the cordon node nearest
;; its building, and the commuter is drawn at the building on arrival.
;; A home that is not a road node (synthetic folders such as demo_scenario) starts with a straight
;; hop to its nearest node; the setup message counts homes more than 500 m from one.
to make-routes
  reset-timer
  let n-leave 0
  let n-far 0
  ask commuters [
    let g my-gate
    let gp list ([gx] of g) ([gy] of g)
    let ns route-nodes home-node [u-node] of g "tt"
    let out node-points ns
    ;; free-flow minutes along the route (the road links' tt, as prep's path weights)
    let tts [ 0 ]
    foreach range (length ns - 1) [ j ->
      let lk [ road-with item (j + 1) ns ] of item j ns
      set tts lput ((last tts) + ifelse-value (lk != nobody) [ [tt] of lk ] [ hop-tt dist-m (item j out) (item (j + 1) out) ]) tts
    ]
    if dist-m (list home-x home-y) (first out) > 500 [ set n-far n-far + 1 ]
    if dist-m (list home-x home-y) (first out) > 0.5 [
      let hop hop-tt dist-m (list home-x home-y) (first out)
      set tts fput 0 map [ t -> t + hop ] tts
      set out fput (list home-x home-y) out
    ]
    ;; the gate point closes the route with the minutes of the whole gate segment (to its inside end,
    ;; where the engine's route to the gate ends)
    let gate-link ifelse-value ([v-node] of g != nobody) [ [ road-with [v-node] of g ] of [u-node] of g ] [ nobody ]
    set tt-out lput ((last tts) + ifelse-value (gate-link != nobody) [ [tt] of gate-link ] [ hop-tt dist-m (last out) gp ]) tts
    set route-out lput gp out
    let wb work-building
    let leg route-nodes (leg-start g) [bnode] of wb "tt-in"
    if any? (turtle-set leg) with [ not in-cordon? ] [ set n-leave n-leave + 1 ]
    ;; the car parks at the road node nearest the building (median 65 m away); the commuter is
    ;; drawn at the building on arrival, so no car drives off the roads (across the wharves)
    set route-in fput gp (node-points leg)
    set len-out cum-lengths route-out
    set len-in cum-lengths route-in
  ]
  print (word "Routes: " count commuters " commuters; " n-leave " legs from a gate to a building use "
              "roads outside the cordon (" precision timer 1 " s)")
  if n-far > 0 [
    print (word n-far " homes are more than 500 m from a road node and start with a straight line "
                "(their folder's homes are not prep origins)")
  ]
end

;; first node after the gate point: the inside end of a prep gate segment, else the gate node
to-report leg-start [ g ]
  report ifelse-value ([v-node] of g != nobody) [ [v-node] of g ] [ [u-node] of g ]
end

;; ------------------------------------------------------------------ views

to set-map-view [ v ]
  if not is-list? road-classes [ user-message "Press setup first." stop ]
  if not member? v [ "Auckland" "City centre" ] [ error (word "unknown map view " v) ]
  set map-view v
  apply-envelope view-envelope v
  draw-map
  place-gates
  update-commuters
  display   ;; the view updates on ticks; a view change between ticks must show at once
end

to apply-envelope [ env ]
  gis:set-world-envelope env
  set map-env gis:world-envelope
end

;; [minx maxx miny maxy] NZTM of view v: the layer's envelope plus a margin (gis:set-world-envelope
;; widens it to the world's aspect ratio)
to-report view-envelope [ v ]
  let cc? v = "City centre"
  let env ifelse-value cc? [ gis:envelope-of cordon-ds ] [ gis:envelope-of roads-ds ]
  let margin ifelse-value cc? [ 0.15 ] [ 0.01 ]
  let w ((item 1 env) - (item 0 env)) * margin
  let h ((item 3 env) - (item 2 env)) * margin
  report (list ((item 0 env) - w) ((item 1 env) + w) ((item 2 env) - h) ((item 3 env) + h))
end

;; NZTM metres -> [xcor ycor] (gis:location-of's mapping); [] outside the world
to-report map-xy [ x y ]
  let px (min-pxcor - 0.5) + (x - item 0 map-env) * world-width / ((item 1 map-env) - (item 0 map-env))
  let py (min-pycor - 0.5) + (y - item 2 map-env) * world-height / ((item 3 map-env) - (item 2 map-env))
  if (px < min-pxcor - 0.5) or (px >= max-pxcor + 0.5) or (py < min-pycor - 0.5) or (py >= max-pycor + 0.5)
    [ report [] ]
  report list px py
end

;; turtle procedure: show at NZTM (x, y), hidden when outside the view
to place-at [ x y ]
  let p map-xy x y
  ifelse empty? p [ set hidden? true ] [ setxy (item 0 p) (item 1 p)  set hidden? false ]
end

to draw-map
  clear-drawing
  let cc? map-view = "City centre"
  if cc? [
    gis:set-drawing-color gray - 3.5
    gis:fill buildings-ds 0
  ]
  ;; local roads first, motorways last so they stay on top
  foreach [ 4 3 2 1 0 ] [ k ->
    gis:set-drawing-color road-color k
    let w road-width k cc?
    foreach item k (ifelse-value cc? [ road-classes-cc ] [ road-classes ]) [ f -> gis:draw f w ]
  ]
  draw-sections sec-order false
  set grade-pending []
  draw-cordon
end

to draw-cordon
  gis:set-drawing-color white
  gis:draw cordon-ds ifelse-value (map-view = "City centre") [ 2 ] [ 1.5 ]
end

;; draw the road sections at positions ids in the colour of their speed grade: normal in the road's
;; grey, slow, heavy and jammed in grade-colors, each a little wider than the one before. erase? first
;; paints them black, 2 wider than they are drawn now: lines are drawn anti-aliased, so a line drawn
;; again over itself would grow bolder at every change, and a black line only 1 wider leaves a faint
;; rim of the old colour (roads back to normal after the peak looked brownish).
to draw-sections [ ids erase? ]
  let cc? map-view = "City centre"
  let feats ifelse-value cc? [ sec-feats-cc ] [ sec-feats ]
  if erase? [
    gis:set-drawing-color black
    foreach ids [ i ->
      let w (section-width (item i sec-frc) (item i grade-shown) cc?) + 2
      foreach item i feats [ f -> gis:draw f w ]
    ]
  ]
  foreach ids [ i ->
    let k item i sec-frc
    let g item i speed-grade
    gis:set-drawing-color ifelse-value (g = 0) [ road-color k ] [ item (g - 1) grade-colors ]
    let w section-width k g cc?
    foreach item i feats [ f -> gis:draw f w ]
    set grade-shown replace-item i grade-shown g
  ]
end

;; sections redrawn per tick at most (about 0.1 ms each, with the erase, in the Auckland view), so
;; that a 5-minute mark at which many roads change colour (07:30, 08:15, 09:15: 500 to 900 sections)
;; does not stall the animation
to-report road-redraw-budget
  report 60
end

;; Every 5 simulated minutes: grade the sections again (regrade-roads) and queue those whose colour
;; changed; each tick redraws up to road-redraw-budget of the queue over the drawing (a view change
;; redraws the whole map)
to update-road-colours
  if empty? sec-feats [ stop ]
  if 5 * floor (clock / 5) != grade-minute [ regrade-roads ]
  draw-pending road-redraw-budget
end

;; redraw the first n queued sections
to draw-pending [ n ]
  if empty? grade-pending [ stop ]
  let k min (list n length grade-pending)
  draw-sections sublist grade-pending 0 k true
  set grade-pending sublist grade-pending k length grade-pending
  draw-cordon
end

;; grade every section at the last 5-minute mark of the clock (speed-grades-at) and queue, in
;; sec-order, the sections whose colour on the map differs from their grade's
to regrade-roads
  let m 5 * floor (clock / 5)
  set speed-grade speed-grades-at m
  set grade-minute m
  set grade-pending filter [ i -> (item i speed-grade) != (item i grade-shown) ] sec-order
end

;; speed grade of every section at minute m, from its speed factor: the engine's road-speed-factor
;; (background traffic of minute m plus today's commuter entries at minutes m - road-window .. m - 1,
;; over the section's capacity; speed / free-flow speed, at least road-floor)
to-report speed-grades-at [ m ]
  let cs n-values length sec-ids [ 0 ]
  foreach (range (m - road-window) m) [ j ->
    let k j - grade-first-min
    if (k >= 0) and (k < length grade-entries) [
      foreach item k grade-entries [ en -> set cs replace-item (item 0 en) cs ((item (item 0 en) cs) + (item 1 en)) ]
    ]
  ]
  report (map [ [i c] -> speed-grade-of road-speed-factor i m c ] (range length sec-ids) cs)
end

;; 0 = normal (f >= 0.80), 1 = slow (0.60 <= f < 0.80), 2 = heavy (0.40 <= f < 0.60), 3 = jammed
to-report speed-grade-of [ f ]
  let bands grade-bands
  let g 0
  while [ (g < 3) and (f < item g bands) ] [ set g g + 1 ]
  report g
end

;; today's commuter entries (today-road rows [section_id minute entries]) grouped by minute, for
;; speed-grades-at
to index-road-entries
  set grade-entries []
  set grade-first-min 0
  if empty? today-road [ stop ]
  let rows item 1 today-road
  if empty? rows [ stop ]
  set grade-first-min min map [ r -> item 1 r ] rows
  let by-min n-values ((max map [ r -> item 1 r ] rows) - grade-first-min + 1) [ [] ]
  foreach rows [ r ->
    let k (item 1 r) - grade-first-min
    set by-min replace-item k by-min (lput (list (table:get sec-index item 0 r) (item 2 r)) (item k by-min))
  ]
  set grade-entries by-min
end

;; gates at their crossing point. In the City centre view each corridor is labelled below its
;; busiest gate with the number of cars waiting in its queue, by a tag turtle (the last breed, so the
;; label is drawn above gates and cars; update-tags refreshes it every minute).
to place-gates
  let cc? map-view = "City centre"
  ask gates [
    place-at gx gy
    set size ifelse-value cc? [ 3 ] [ 2 ]
  ]
  ask tags [ die ]
  if cc? [
    foreach corr-ids [ cid ->
      let gs gates with [ corridor-id = cid and not hidden? ]
      if any? gs [
        let g max-one-of gs [ count commuters with [ my-gate = myself ] ]
        let k table:get corr-index cid
        ;; a label ends at its turtle; about 1.4 patches per character at this patch and font size
        let w 1.4 * length (word compass-abbrev item k corr-names " " cid ": 99 waiting")
        create-tags 1 [
          set size 0
          set tag-cid cid
          setxy (max (list (min-pxcor - 0.5 + w) (min (list (max-pxcor + 0.49) ([xcor] of g + w / 2)))))
                (max (list (min-pycor - 0.5) ([ycor] of g - 3.5)))
          set label-color white
        ]
      ]
    ]
  ]
end

;; ------------------------------------------------------------------ days

;; One tick = 15 simulated seconds. The day ends when every commuter has arrived; go then stops,
;; or with keep-going? on the next day follows.
to go
  if not is-list? road-classes [ user-message "Press setup first." stop ]
  if not day-running? [
    start-day current-day + 1
    if not day-running? [ stop ]
  ]
  set clock min (list day-end-min (clock + 1 / steps-per-minute))
  update-commuters
  update-road-colours
  if clock >= day-end-min [ draw-pending length grade-pending ]   ;; the last frame of the day is up to date
  plot-until clock
  tick
  if clock >= day-end-min [
    end-day
    if not keep-going? [ stop ]
  ]
end

;; the rest of today (or the whole next day) at once, without animation
to finish-day
  if not is-list? road-classes [ user-message "Press setup first." stop ]
  if not day-running? [
    start-day current-day + 1
    if not day-running? [ stop ]
  ]
  let skipped day-end-min - clock
  set clock day-end-min
  update-commuters
  update-road-colours
  draw-pending length grade-pending
  plot-until clock
  tick-advance skipped * steps-per-minute
  display
  end-day
end

to start-day [ d ]
  let f (word "plans_day" pad2 d ".csv")
  let rows []
  ifelse file-exists? path-join scen-dir f [ set rows read-rows scen-dir f ] [
    if scen-n-days >= 0 [
      user-message (word "This run has " scen-n-days " days: there is no plans file for day " d ".")
      stop
    ]
    set rows demo-plans d
  ]
  set current-day d
  set fee-active-today? charge-on? d
  ask commuters [
    set mode-today "NONE"
    set dep -1
    set gate-arr -1
    set gate-exit -1
    set arr -1
    set q-rank 0
  ]
  let h first rows
  let ia col h "agent_id"
  let im col h "mode"
  let idep col h "depart_min"
  foreach but-first rows [ r ->
    if not table:has-key? commuter-of item ia r [ error (word "unknown agent_id " item ia r) ]
    ask table:get commuter-of item ia r [
      set mode-today (word item im r)
      if mode-today = "CAR" [ set dep item idep r ]
      if mode-today = "PT" [
        ;; PT minutes come from the run's outcomes.csv; without it a rider is at work all day
        let key (word d " " agent-id)
        ifelse table:has-key? pt-times key
          [ set dep item 0 table:get pt-times key  set arr item 1 table:get pt-times key ]
          [ set dep sim-start-min  set arr sim-start-min ]
      ]
    ]
  ]
  simulate-queues
  plan-drives
  index-road-entries
  let cars commuters with [ mode-today = "CAR" ]
  set n-cars count cars
  let served cars with [ gate-exit >= 0 ]
  let delays [ gate-exit - gate-arr ] of served
  set mean-delay ifelse-value (empty? delays) [ 0 ] [ mean delays ]
  set max-delay ifelse-value (empty? delays) [ 0 ] [ max delays ]
  set day-exits [ gate-exit ] of served
  ;; the day runs from shortly before the first departure until the last commuter has arrived (a
  ;; car the engine never serves keeps it open to sim-end-cap-min); the tick counter counts 15-second
  ;; steps from the start of the engine clock (sim-start-min, 05:30)
  let movers commuters with [ dep >= 0 ]
  let first-dep ifelse-value any? movers [ min [ dep ] of movers ] [ sim-start-min ]
  set day-start max (list sim-start-min (15 * floor ((first-dep - 10) / 15)))
  let ends sentence [ arr ] of commuters with [ arr >= 0 ]
                    (ifelse-value any? cars with [ gate-exit = -1 ] [ (list sim-end-cap-min) ] [ [] ])
  set day-end-min (max (fput (day-start + 1) ends)) + 2
  reset-ticks
  tick-advance (day-start - sim-start-min) * steps-per-minute
  set clock day-start
  set last-plot-min day-start - 1
  set day-running? true
  setup-day-plots
  update-commuters
  set grade-minute -1   ;; today's traffic: grade again at day-start
  update-road-colours
  plot-until clock
end

;; Today's drive of every car from home to its gate: t-out, the minute it passes each point of
;; route-out. With road files the car follows its section times from road-arrivals (today-road): the
;; free-flow minutes of route it covers grow at each section's congested pace, so it slows down on
;; busy roads. The times are stretched (by about a minute at most: the engine rounds the free-flow
;; minutes to the gate and the road delay to whole minutes) so that it reaches the gate point
;; exactly at gate-arr, the engine's whole minute. Without a route it drives at constant speed.
to plan-drives
  let delays ifelse-value (empty? today-road) [ table:make ] [ item 0 today-road ]
  let times ifelse-value (empty? today-road) [ table:make ] [ item 2 today-road ]
  ask commuters [
    set out-ptr 0
    set road-delay -1
    set t-out []
    if mode-today = "CAR" [
      set road-delay table:get-or-default delays agent-id 0
      set t-out ifelse-value (table:has-key? times agent-id) [ section-clock table:get times agent-id ] [ even-clock ]
    ]
  ]
end

;; commuter reporter: the minute the car passes each point of route-out at constant speed by metres
to-report even-clock
  let total last len-out
  report lput gate-arr butlast map [ x -> ifelse-value (total > 0) [ dep + (gate-arr - dep) * x / total ] [ dep ] ] len-out
end

;; commuter reporter: the minute the car passes each point of route-out on the section times tms of
;; road-arrivals ([t0 .. tn], elapsed minutes at the entry of each section of its route and at the
;; gate). A point at free-flow minutes F of the route (tt-out, scaled to the route's free-flow sum)
;; lies in the section k whose free-flow minutes span F; the car passes it at
;; t_k + (t_k+1 - t_k) x (share of section k before it), stretched by (gate-arr - dep) / tn.
to-report section-clock [ tms ]
  let cum [ 0 ]   ;; free-flow minutes of the route before each section, then in all
  foreach table:get agent-route agent-id [ i -> set cum lput ((last cum) + (item i sec-ff)) cum ]
  let tn last tms
  let full last tt-out
  if (tn <= 0) or (full <= 0) or (gate-arr <= dep) [ report even-clock ]
  let stretch (gate-arr - dep) / tn
  let scale (last cum) / full
  let nk length cum - 2
  let k 0         ;; the section the point lies in
  let out (list dep)
  foreach butlast but-first tt-out [ tt-pt ->
    let f tt-pt * scale
    while [ (k < nk) and (item (k + 1) cum <= f) ] [ set k k + 1 ]
    let lo item k cum
    let span (item (k + 1) cum) - lo
    let share ifelse-value (span > 0) [ (f - lo) / span ] [ 1 ]   ;; >= 0: lo <= f
    if share > 1 [ set share 1 ]
    let tk item k tms
    let t dep + (tk + ((item (k + 1) tms) - tk) * share) * stretch
    set out lput (ifelse-value (t < gate-arr) [ t ] [ gate-arr ]) out
  ]
  report lput gate-arr out
end

to end-day
  set day-running? false
end

;; Demo plans when a folder has no plans file (demo_scenario): every commuter drives, departing
;; 06:45 to 08:00 (seed 1000 + d - 1, as the earlier schematic replay GUI).
to-report demo-plans [ d ]
  let rows []
  with-local-randomness [
    random-seed 1000 + d - 1
    set rows map [ aid -> (list aid "CAR" (405 + 15 * random 6)) ] sort table:keys agent-fg
  ]
  report fput [ "agent_id" "mode" "depart_min" ] rows
end

;; ------------------------------------------------------------------ engine

;; Roads from home to the gate (PyEngine: cordonlite/roads.py simulate_roads, ported line by line:
;; the same operations in the same order, so both engines compute the same numbers).
;; cars: one [agent_id depart_min] per car today, in any order. Each car drives its route
;; (agent-route) section by section. It enters a section at minute m = depart + floor(elapsed),
;; with that section's speed factor at m (road-speed-factor: background flow of minute m plus the
;; commuter entries at minutes m - road-window .. m - 1, never those of m itself, so the order of
;; the cars within a minute does not matter), records one entry of the section at m and adds
;; free-flow minutes / speed factor to its elapsed minutes. Road delay = floor(elapsed - free-flow
;; sum + 0.5), at least 0; it is 0 for a car without a route and for every car when road-on? is
;; false. Gate arrival = depart + fftt_to_gate_min (agents.csv) + road delay.
;; Reports [delays entries times extras counts]:
;;   delays   table agent_id -> road delay (whole minutes) of every car passed in
;;   entries  rows [section_id minute entries] (entries > 0), by section_id, then minute
;;            (road_dayNN.csv without the day column)
;;   times    table agent_id -> [t0 t1 ... tn] for each car with a route of n sections: elapsed
;;            minutes since departure when it enters each section (t0 = 0) and, last, when it
;;            leaves the route at the gate (tn = free-flow sum + extra). Section k of the route
;;            (position item k of agent-route) is driven from depart + t_k to depart + t_(k+1). The
;;            engine's gate arrival is the whole minute depart + fftt_to_gate_min + road delay, so a
;;            drawing that must reach the gate at gate-arr scales these times to it.
;;   extras   table agent_id -> elapsed - free-flow sum (minutes, before rounding; 0 without route)
;;   counts   table (entry-key i m) -> commuter entries of the section at position i (sec-ids
;;            order) in minute m; road-window-count counts i m is its count in the flow window
;;            before m (one table, not one per section: each table:make gets slower while many
;;            tables are alive)
to-report road-arrivals [ cars ]
  let delays table:make
  let extras table:make
  let times table:make
  foreach cars [ cr ->
    table:put delays (item 0 cr) 0
    table:put extras (item 0 cr) 0
  ]
  if not road-on? [ report (list delays [] times extras table:make) ]
  ;; cars with a route: departure minute, elapsed minutes, next route position, free-flow sum
  let r-dep table:make
  let r-el table:make
  let r-k table:make
  let r-ffsum table:make
  foreach cars [ cr ->
    let aid item 0 cr
    let rte table:get-or-default agent-route aid []
    if not empty? rte [
      table:put r-dep aid (item 1 cr)
      table:put r-el aid 0
      table:put r-k aid 0
      let s-ff 0
      foreach rte [ i -> set s-ff s-ff + (item i sec-ff) ]   ;; left to right, in seq order
      table:put r-ffsum aid s-ff
      table:put times aid [ 0 ]
    ]
  ]
  let counts table:make
  let buckets table:make   ;; minute -> agent_ids that enter their next section at that minute
  foreach table:keys r-dep [ aid ->
    let m0 table:get r-dep aid
    table:put buckets m0 (lput aid (table:get-or-default buckets m0 []))
  ]
  let unfinished table:length r-dep
  let m ifelse-value (unfinished > 0) [ min table:values r-dep ] [ 0 ]
  while [ unfinished > 0 ] [
    if table:has-key? buckets m [
      let ids sort table:get buckets m
      table:remove buckets m
      foreach ids [ aid ->
        let d0 table:get r-dep aid
        let rte table:get agent-route aid
        let el table:get r-el aid
        let k table:get r-k aid
        let tms table:get times aid
        let done? false
        while [ (not done?) and ((d0 + (floor el)) = m) ] [
          let i item k rte
          let f road-speed-factor i m (road-window-count counts i m)
          let key entry-key i m
          table:put counts key ((table:get-or-default counts key 0) + 1)   ;; one more entry of i at minute m
          set el el + ((item i sec-ff) / f)
          set k k + 1
          set tms lput el tms
          if k = length rte [ set done? true ]
        ]
        table:put r-el aid el
        table:put r-k aid k
        table:put times aid tms
        ifelse done? [ set unfinished unfinished - 1 ] [
          let nb d0 + (floor el)   ;; always a later minute
          table:put buckets nb (lput aid (table:get-or-default buckets nb []))
        ]
      ]
    ]
    set m m + 1
  ]
  foreach table:keys r-dep [ aid ->
    let xm (table:get r-el aid) - (table:get r-ffsum aid)
    table:put extras aid xm
    table:put delays aid (max (list 0 (floor (xm + 0.5))))
  ]
  let rows []
  foreach sort table:keys counts [ key ->   ;; ascending key = by section position, then minute
    let i floor (key / 100000)
    set rows lput (list (item i sec-ids) (key - (i * 100000)) (table:get counts key)) rows
  ]
  report (list delays rows times extras counts)
end

;; key of section position i and minute m (0 <= m < 100000) in the counts table of road-arrivals
to-report entry-key [ i m ]
  report (i * 100000) + m
end

;; commuter entries of the section at position i at minutes m - road-window .. m - 1 (counts: the
;; table of road-arrivals)
to-report road-window-count [ counts i m ]
  let c 0
  let j m - road-window
  while [ j < m ] [
    set c c + (table:get-or-default counts (entry-key i j) 0)
    set j j + 1
  ]
  report c
end

;; flow (veh/h) on the section at position i in minute m with c commuter entries in the flow window:
;; background peak flow x profile of minute m (the last profile minute after 23:59) + c x sec-fpe
to-report road-volume [ i m c ]
  let rm ifelse-value (m < 1440) [ item m road-r ] [ item 1439 road-r ]
  report ((item i sec-bg) * rm) + (c * (item i sec-fpe))
end

;; speed factor (share of free-flow speed) of the section at position i in minute m with c commuter
;; entries in the flow window: BPR with beta 4, x4 = (x * x) * (x * x) (not x ^ 4), at least road-floor
to-report road-speed-factor [ i m c ]
  let x (road-volume i m c) / (item i sec-cap)
  let x4 (x * x) * (x * x)
  let f 1 / (1 + (road-alpha * x4))
  if f < road-floor [ set f road-floor ]
  report f
end

;; The Cordon-Lite engine: one Vickrey point queue per corridor at minute resolution (PyEngine,
;; simulate_point_queues). arrivals: one [gate-arrival-minute agent_id corridor_id] per car. Each
;; minute from sim-start-min, the cars that have arrived join their corridor queue (FIFO by arrival
;; minute, then agent_id) and the corridor serves floor(carry + capacity) of them; the remainder is
;; carried to the next minute and capped at 1 when the queue empties. It stops when every car is
;; served or at sim-end-cap-min. Reports [exits profile last-minute]: exits = table agent_id ->
;; gate-exit minute (a car not in it was not served); profile = rows [corridor_id minute arrivals
;; served queue_len], corridor by corridor.
to-report point-queues [ arrivals ]
  let nk length corr-ids
  let lanes n-values nk [ [] ]
  foreach arrivals [ row ->
    let k table:get corr-index (item 2 row)
    set lanes replace-item k lanes (lput (list (item 0 row) (item 1 row)) (item k lanes))
  ]
  set lanes map [ lane0 -> sort-by [ [p q] -> ((item 0 p) < (item 0 q)) or (((item 0 p) = (item 0 q)) and ((item 1 p) < (item 1 q))) ] lane0 ] lanes
  let n-total length arrivals
  let arr-ptr n-values nk [ 0 ]
  let srv-ptr n-values nk [ 0 ]
  let carry n-values nk [ 0 ]
  let prof n-values nk [ [] ]
  let exits table:make
  let served-total 0
  let m sim-start-min
  let done? false
  while [ not done? ] [
    foreach range nk [ k ->
      let lane item k lanes
      let ap item k arr-ptr
      let n-arr 0
      while [ (ap < length lane) and ((item 0 (item ap lane)) <= m) ] [
        set ap ap + 1
        set n-arr n-arr + 1
      ]
      let sp item k srv-ptr
      let avail (item k carry) + (item k corr-caps)
      let n min (list (ap - sp) (floor avail))
      repeat n [
        table:put exits (item 1 (item sp lane)) m
        set sp sp + 1
      ]
      let cr avail - n
      if sp = ap [ set cr min (list cr 1) ]
      set carry replace-item k carry cr
      set arr-ptr replace-item k arr-ptr ap
      set srv-ptr replace-item k srv-ptr sp
      set served-total served-total + n
      set prof replace-item k prof (lput (list (item k corr-ids) m n-arr n (ap - sp)) (item k prof))
    ]
    ifelse (served-total = n-total) or (m >= sim-end-cap-min) [ set done? true ] [ set m m + 1 ]
  ]
  report (list exits (ifelse-value (nk = 0) [ [] ] [ reduce sentence prof ]) m)
end

;; today's cars on screen: gate-arr, gate-exit (-1 when not served by sim-end-cap-min) and arr, from
;; the engine's road-arrivals and point-queues (so the same minutes as the run); today-road keeps
;; the road-arrivals result (road delays, section entries, each car's section times)
to simulate-queues
  let cars sort-on [ agent-id ] commuters with [ mode-today = "CAR" ]
  foreach cars [ c ->
    ask c [
      if (dep + (table:get agent-fg agent-id)) < sim-start-min [
        error (word "agent " agent-id " reaches its gate before sim-start-min")
      ]
    ]
  ]
  set today-road road-arrivals map [ c -> [ list agent-id dep ] of c ] cars
  let road-delays item 0 today-road
  let arrivals []
  foreach cars [ c ->
    ask c [
      set gate-arr (dep + (table:get agent-fg agent-id)) + (table:get road-delays agent-id)
      set arrivals lput (list gate-arr agent-id corridor-id) arrivals
    ]
  ]
  let exits item 0 point-queues arrivals
  foreach cars [ c ->
    ask c [
      set gate-exit ifelse-value (table:has-key? exits agent-id) [ table:get exits agent-id ] [ -1 ]
      set arr ifelse-value (gate-exit >= 0) [ gate-exit + table:get agent-gd agent-id ] [ -1 ]
    ]
  ]
end

;; ------------------------------------------------------------------ headless engine (NetLogoEngine)
;; Python (cordonlite/engine.py) loads this model through pynetlogo and calls:
;;   setup-from-dir "<dir>"            reads corridors.csv, agents.csv, fees.csv and the road files when
;;                                     present (read-roads; no map, no network)
;;   set-clock <sim-start> <cap>       engine clock (defaults 330 and 720)
;;   run-day <day> "<dir>" <fee?>      reads plans_dayNN.csv, writes outcomes_dayNN.csv, profile_dayNN.csv
;;                                     and road_dayNN.csv

to setup-from-dir [ dir ]
  clear-all
  set scen-dir dir
  set sim-start-min 330
  set sim-end-cap-min 720
  set current-day 0
  set day-running? false
  set fee-active-today? false
  set n-cars 0
  set mean-delay 0
  set max-delay 0
  set last-minute sim-start-min
  set last-profile []
  set last-exits []
  set last-road []
  set today-road []
  set agent-mode table:make
  read-corridors
  read-agents
  read-fees
  read-scenario-meta
  read-roads
  reset-ticks
end

to set-clock [ start cap ]
  set sim-start-min start
  set sim-end-cap-min cap
end

to run-day [ d dir fee? ]
  run-day-io d dir dir fee?
end

;; plans_dayNN.csv from in-dir; outcomes_dayNN.csv, profile_dayNN.csv and road_dayNN.csv (header only
;; without road files) to out-dir
to run-day-io [ d in-dir out-dir fee? ]
  set current-day d
  set fee-active-today? fee?
  let rows read-rows in-dir (word "plans_day" pad2 d ".csv")
  let h first rows
  let ia col h "agent_id"
  let im col h "mode"
  let idep col h "depart_min"
  let cars []       ;; [agent_id corridor_id depart]
  set agent-mode table:make
  foreach but-first rows [ r ->
    let aid item ia r
    let md (word item im r)
    table:put agent-mode aid md
    if md = "CAR" [
      if not table:has-key? agent-corr aid [ error (word "unknown agent_id " aid) ]
      let cid table:get agent-corr aid
      let dep-min item idep r
      ;; as PyEngine (car_rows): checked on the free-flow arrival; the road delay is never negative
      if (dep-min + (table:get agent-fg aid)) < sim-start-min [
        error (word "agent " aid " reaches its gate before sim-start-min")
      ]
      set cars lput (list aid cid dep-min) cars
    ]
  ]
  ;; gate arrival = depart + free-flow minutes to the gate + road delay
  let road-res road-arrivals map [ c -> list (item 0 c) (item 2 c) ] cars
  let road-delays item 0 road-res
  set cars map [ c -> (lput ((item 2 c) + (table:get agent-fg (item 0 c)) + (table:get road-delays (item 0 c))) c) ] cars
  let arrivals map [ c -> (list (item 3 c) (item 0 c) (item 1 c)) ] cars   ;; [gate-arrival agent_id corridor_id]
  let result point-queues arrivals
  let exits item 0 result
  set last-minute item 2 result
  let out []
  let delays []
  let exit-list []
  foreach sort-by [ [p q] -> (item 0 p) < (item 0 q) ] cars [ c ->
    let aid item 0 c
    let a item 3 c
    let rd table:get road-delays aid
    ifelse table:has-key? exits aid [
      let x table:get exits aid
      let fee ifelse-value fee? [ item x fee-list ] [ 0 ]
      set out lput (list aid d (item 1 c) (item 2 c) rd a x (x - a) (x + table:get agent-gd aid) fee) out
      set delays lput (x - a) delays
      set exit-list lput x exit-list
    ] [
      set out lput (list aid d (item 1 c) (item 2 c) rd a -1 -1 -1 0) out
    ]
  ]
  set n-cars length cars
  set mean-delay ifelse-value (empty? delays) [ 0 ] [ mean delays ]
  set max-delay ifelse-value (empty? delays) [ 0 ] [ max delays ]
  set last-exits exit-list
  set last-profile map [ row -> fput d row ] (item 1 result)
  set last-road map [ row -> fput d row ] (item 1 road-res)
  csv:to-file (path-join out-dir (word "outcomes_day" pad2 d ".csv"))
    fput [ "agent_id" "day" "corridor_id" "depart_min" "road_delay_min" "gate_arrive_min" "gate_exit_min" "queue_delay_min" "arrive_min" "fee_paid" ] out
  csv:to-file (path-join out-dir (word "profile_day" pad2 d ".csv"))
    fput [ "day" "corridor_id" "minute" "arrivals" "served" "queue_len" ] last-profile
  csv:to-file (path-join out-dir (word "road_day" pad2 d ".csv"))
    fput [ "day" "section_id" "minute" "entries" ] last-road
end

;; ------------------------------------------------------------------ positions

;; commuter reporter: "home" | "driving" | "queued" | "transit" (PT) | "work" at minute m
to-report state-at [ m ]
  if mode-today = "CAR" [
    if m < dep [ report "home" ]
    if m < gate-arr [ report "driving" ]
    if (gate-exit = -1) or (m < gate-exit) [ report "queued" ]
    if m < arr [ report "driving" ]
    report "work"
  ]
  if mode-today = "PT" [
    if m < dep [ report "home" ]
    if m < arr [ report "transit" ]
    report "work"
  ]
  report "home"
end

to update-commuters
  rank-queues
  ask commuters [ place-now ]
  update-tags
end

;; corridor label: compass sector, corridor id and the cars waiting in its queue now
to update-tags
  ask tags [
    let cid tag-cid
    let k table:get corr-index cid
    set label (word compass-abbrev item k corr-names " " cid ": "
                    count commuters with [ corridor-id = cid and state-at clock = "queued" ] " waiting")
  ]
end

;; place in the queue at each gate: FIFO by gate arrival minute, then agent_id (the engine's order)
to rank-queues
  let q sort-by [ [a b] -> ([gate-arr] of a < [gate-arr] of b) or
                           (([gate-arr] of a = [gate-arr] of b) and ([agent-id] of a < [agent-id] of b)) ]
          commuters with [ state-at clock = "queued" ]
  let seen table:make
  foreach q [ c ->
    let g [ [who] of my-gate ] of c
    let r table:get-or-default seen g 0
    ask c [ set q-rank r ]
    table:put seen g (r + 1)
  ]
end

;; commuter procedure: draw at today's position for the current clock
to place-now
  let s state-at clock
  let cc? map-view = "City centre"
  let base ifelse-value (mode-today = "PT") [ green + 2 ]
           [ ifelse-value (mode-today = "CAR" or mode-today = "NONE") [ corridor-color corridor-id ] [ gray ] ]
  set color base
  if s = "transit" [ set hidden? true  stop ]
  if s = "home" [
    set shape "dot"
    set size ifelse-value cc? [ 1.5 ] [ 1.2 ]
    place-at home-x home-y
    stop
  ]
  if s = "work" [
    set shape "dot"
    set size ifelse-value cc? [ 2 ] [ 0.8 ]
    place-at [bx] of work-building [by] of work-building
    stop
  ]
  ;; on the road: driving to the gate (on its section times), queued before it (red), or driving
  ;; from it to the building
  if s = "queued" [ set color red ]
  set shape "car"
  set size ifelse-value cc? [ 4 ] [ 2.5 ]
  let p []
  ifelse s = "queued" [
    set p point-along route-out len-out max (list 0 ((last len-out) - q-rank * queue-spacing-m))
  ] [
    ifelse clock < gate-arr [
      set p drive-point clock
    ] [
      set p point-along route-in len-in
              ifelse-value (arr > gate-exit) [ (last len-in) * (clock - gate-exit) / (arr - gate-exit) ] [ last len-in ]
    ]
  ]
  place-at (item 0 p) (item 1 p)
  set heading item 2 p
end

;; commuter reporter: [x y heading] on route-out at minute m of today's drive to the gate: between
;; the two points it passes before and after m (t-out), at the share of that stretch's minutes gone.
;; At gate-arr it is the gate point. out-ptr remembers the last point passed (the clock only moves on).
to-report drive-point [ m ]
  let n length t-out
  if (out-ptr > 0) and (item out-ptr t-out > m) [ set out-ptr 0 ]
  while [ (out-ptr < n - 2) and (item (out-ptr + 1) t-out <= m) ] [ set out-ptr out-ptr + 1 ]
  let a item out-ptr route-out
  let b item (out-ptr + 1) route-out
  let ta item out-ptr t-out
  let tb item (out-ptr + 1) t-out
  let f ifelse-value (tb > ta) [ max (list 0 (min (list 1 ((m - ta) / (tb - ta))))) ] [ 1 ]
  report (list ((item 0 a) + f * ((item 0 b) - (item 0 a)))
               ((item 1 a) + f * ((item 1 b) - (item 1 a)))
               (bearing-of a b))
end

;; [x y heading] at distance d (metres) along the polyline pts with cumulative lengths cum
to-report point-along [ pts cum d ]
  let n length pts
  if n = 1 [ report (list (item 0 first pts) (item 1 first pts) 0) ]
  let i 1
  while [ (i < n - 1) and (item i cum < d) ] [ set i i + 1 ]
  let a item (i - 1) pts
  let b item i pts
  let la item (i - 1) cum
  let lb item i cum
  let f ifelse-value (lb > la) [ max (list 0 (min (list 1 ((d - la) / (lb - la))))) ] [ 1 ]
  report (list ((item 0 a) + f * ((item 0 b) - (item 0 a)))
               ((item 1 a) + f * ((item 1 b) - (item 1 a)))
               (bearing-of a b))
end

to-report bearing-of [ a b ]
  let ddx (item 0 b) - (item 0 a)
  let ddy (item 1 b) - (item 1 a)
  report ifelse-value ((ddx = 0) and (ddy = 0)) [ 0 ] [ atan ddx ddy ]
end

;; ------------------------------------------------------------------ monitors and plots

to-report n-state [ s ]
  report count commuters with [ state-at clock = s ]
end

;; mean road delay (min) of today's cars that have reached their gate so far (0 before the first)
to-report traffic-delay-now
  let done commuters with [ mode-today = "CAR" and gate-arr >= 0 and gate-arr <= clock ]
  report ifelse-value (any? done) [ mean [ road-delay ] of done ] [ 0 ]
end

;; plots use hours on the x-axis (7.5 = 07:30)
to setup-day-plots
  let x0 day-start
  let x1 max (list (x0 + 15) day-end-min)
  set-current-plot "Commuters"
  clear-plot
  set-plot-x-range (x0 / 60) (x1 / 60)
  set-current-plot "Queue length by corridor"
  clear-plot
  set-plot-x-range (x0 / 60) (x1 / 60)
  foreach range length corr-ids [ k ->
    create-temporary-plot-pen (word item k corr-ids ": " item k corr-names)
    set-plot-pen-color corridor-color item k corr-ids
  ]
  set-current-plot "Cordon entries per 15 min"
  clear-plot
  set-plot-x-range (x0 / 60) (x1 / 60)
  ;; charge drawn scaled so its peak equals the day's highest 15-min entry count (shape only)
  set-current-plot-pen "charge (scaled)"
  if fee-active-today? [
    let counts map [ b -> length filter [ x -> (x >= b) and (x < b + 15) ] day-exits ] (range x0 x1 15)
    let top max (fput 1 counts)
    let fmax max (fput 0.01 sublist fee-list x0 x1)
    foreach (range x0 x1) [ mm -> plotxy (mm / 60) (top * (item mm fee-list) / fmax) ]
  ]
end

;; one point per whole minute up to m (a finished day is plotted in full)
to plot-until [ m ]
  while [ last-plot-min < floor m ] [
    set last-plot-min last-plot-min + 1
    let mm last-plot-min
    let states [ state-at mm ] of commuters
    set-current-plot "Commuters"
    set-current-plot-pen "driving"
    plotxy (mm / 60) length filter [ s -> s = "driving" ] states
    set-current-plot-pen "queued"
    plotxy (mm / 60) length filter [ s -> s = "queued" ] states
    set-current-plot-pen "at work"
    plotxy (mm / 60) length filter [ s -> s = "work" ] states
    set-current-plot "Queue length by corridor"
    foreach range length corr-ids [ k ->
      let cid item k corr-ids
      set-current-plot-pen (word cid ": " item k corr-names)
      plotxy (mm / 60) count commuters with [ corridor-id = cid and state-at mm = "queued" ]
    ]
  ]
  set-current-plot "Cordon entries per 15 min"
  set-current-plot-pen "entries"
  histogram map [ x -> x / 60 ] filter [ x -> x <= m ] day-exits
end]]></code>
